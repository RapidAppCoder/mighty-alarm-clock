<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/alarm_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="0dp"
        android:paddingBottom="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/alarm_search_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:hint="@string/mighty_search_alarms_hint"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <!-- Row 1: filter chips + reset -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/alarm_filter_chip_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/alarm_filter_chip_enabled"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mighty_filter_enabled" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/alarm_filter_chip_repeating"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mighty_filter_repeating" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/alarm_filter_chip_one_shot"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mighty_filter_one_shot" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.chip.Chip
                    android:id="@+id/alarm_filter_chip_reset"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/mighty_filter_reset"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_reset"
                    app:ensureMinTouchTargetSize="false" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Row 2: sort -->
        <Spinner
            android:id="@+id/alarm_sort_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:entries="@array/mighty_alarm_sort_options" />

        <!-- Row 3: tag filter -->
        <!-- Populated programmatically with "All tags" + every user-defined Tag. -->
        <Spinner
            android:id="@+id/alarm_tag_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp" />

    </LinearLayout>

    <include
        layout="@layout/volume_warning_banner"
        android:id="@+id/alarm_volume_warning_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/alarm_filter_bar"
        app:layout_constraintBottom_toTopOf="@+id/alarm_recycler_view" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alarm_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/alarm_list_padding_end"
        android:paddingBottom="@dimen/alarm_list_padding_bottom"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@+id/alarm_volume_warning_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="0dp"
        tools:listitem="@layout/alarm_item" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alarm_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/alarm_empty_view_bottom_padding"
        android:visibility="gone"
        android:alpha="0.7">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/blob"
            android:contentDescription="@string/no_alarms"
            app:layout_constraintWidth_max="@dimen/max_dimension_empty_view"
            app:layout_constraintHeight_max="@dimen/max_dimension_empty_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_empty_alarm_view"
            android:scaleX="0.6"
            android:scaleY="0.6"
            android:alpha="0.5"
            android:contentDescription="@string/no_alarms"
            app:layout_constraintWidth_max="@dimen/max_dimension_empty_view"
            app:layout_constraintHeight_max="@dimen/max_dimension_empty_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
